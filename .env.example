OPENAI_API_KEY=        # optional — only needed if using run_daily.py with OpenAI models
SLACK_BOT_TOKEN=       # your Slack bot token for daily cron posting
APCA_API_KEY_ID=       # optional — Alpaca market data key; when set, price bars and news come from Alpaca
APCA_API_SECRET_KEY=   # optional — Alpaca secret for the key above
ALPACA_DATA_FEED=      # optional — "sip" (default, all US exchanges) or "iex" if your plan rejects sip
